# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (PostgreSQL). Used by dj-database-url.
# Local dev defaults to this if DATABASE_URL is unset:
#   postgres://qortex:qortex@localhost:5432/qortex
# In Docker, docker-compose sets this to point at the `db` service.
DATABASE_URL=postgres://qortex:qortex@localhost:5432/qortex
